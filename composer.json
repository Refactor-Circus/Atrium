{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "refactor-circus/atrium",
    "description": "A plug-and-play dashboard for Laravel that other packages can extend.",
    "keywords": [
        "laravel",
        "refactor-circus",
        "atrium"
    ],
    "homepage": "https://github.com/refactor-circus/atrium",
    "license": "MIT",
    "authors": [
        {
            "name": "Jay Fletcher",
            "email": "5743488+jayjfletcher@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "refactor-circus/keystone": "dev-main",
        "laravel/framework": "^13.35"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/ai": "^1.2",
        "laravel/pao": "^1.1.5",
        "laravel/pennant": "^1.26",
        "laravel/pint": "^1.32.1",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3.4",
        "pestphp/pest-plugin-browser": "^5.1.2",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-type-coverage": "^5.0.3",
        "phpstan/extension-installer": "^1.4.3",
        "refactor-circus/ringside": "dev-main",
        "refactor-circus/standards": "dev-main"
    },
    "suggest": {
        "laravel/ai": "Required to classify global search queries and only run the most relevant search sources (^1.0).",
        "laravel/pennant": "Turn the theme switcher on or off per user with Atrium's ThemeSwitcherFeature, through a feature resolver such as refactor-circus/pennantplus (^1.26)."
    },
    "autoload": {
        "psr-4": {
            "RefactorCircus\\Atrium\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RefactorCircus\\Atrium\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:create-sqlite-db --ansi",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel --exclude-testsuite=Browser"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ],
        "test:browser": [
            "vendor/bin/pest --testsuite=Browser"
        ],
        "local:install": [
            "@php bin/composer-local.php",
            "@putenv COMPOSER=composer.local.json",
            "@composer install"
        ],
        "local:update": [
            "@php bin/composer-local.php",
            "@putenv COMPOSER=composer.local.json",
            "@composer update"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "RefactorCircus\\Atrium\\AtriumServiceProvider"
            ],
            "aliases": {
                "Atrium": "RefactorCircus\\Atrium\\Facades\\Atrium"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "refactor-circus/ringside": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Keystone.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Ringside.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Standards.git"
        }
    ]
}
