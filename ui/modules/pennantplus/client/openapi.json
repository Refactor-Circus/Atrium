                    "scope_label": {
                        "type": "string"
                    },
                    "title": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "global": {
                        "type": "boolean"
                    },
                    "value": {},
                    "active": {
                        "type": "boolean"
                    },
                    "updated_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
