                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "name",
                    "defined",
                    "global",
                    "global_stored",
                    "overrides"
                ],
                "title": "FeatureResource"
            },
            "FeatureValueResource": {
                "type": "object",
                "properties": {
                    "feature": {
                        "type": "string"
