            "UpdateFeatureValueRequest": {
                "type": "object",
                "description": "Store a value \u2014 true, false, or any richer JSON value \u2014 for a scope.",
                "properties": {
                    "feature": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "scope": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "scope_type": {
                        "type": "string",
                        "enum": [
